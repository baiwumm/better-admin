# ── 服务端专用（严禁暴露到浏览器端，见 AGENTS §9）────────────────────────────
# PostgreSQL 连接串（Supabase 托管；连接池端口 6543，禁止携带 sslmode 参数，
# SSL 由代码层配置）。Nest 端迁移为真源，Next 端仅 db:pull 内省使用。
DATABASE_URL=

# ── 认证（N1 认证期启用）────────────────────────────────────────────────────
# access token 签名密钥
JWT_SECRET=
# access token 有效期（缺省 1h）
JWT_EXPIRES_IN=1h
# refresh token 独立签名密钥（可留空回退 JWT_SECRET，与 Nest 端行为一致）
JWT_REFRESH_SECRET=
# refresh token 有效期（记住我 30d / 普通 1d，分档由登录参数决定）
REFRESH_EXPIRES_IN=30d
REFRESH_EXPIRES_IN_SHORT=1d

# ── Supabase Storage（N5 我的账户头像启用，服务端持有 sb_secret 中转）────────
SUPABASE_URL=
# sb_secret_ 前缀的 Secret key（仅服务端持有，浏览器不接触）
SUPABASE_SECRET_KEY=

# ── 日志清理（N4，GitHub Actions cron 直连数据库执行 pnpm db:clean-logs）────
# 日志保留天数（缺省 30，与 Nest 端 log-cleanup 一致）
LOG_RETENTION_DAYS=30

# ── 公开变量（会进入浏览器端代码，仅放非敏感信息）──────────────────────────
NEXT_PUBLIC_APP_NAME=Better Admin
NEXT_PUBLIC_APP_DESC=一个探索多技术栈全栈开发的 Admin 项目。
