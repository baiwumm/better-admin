# 服务端数据库连接（仅服务端，严禁提交真实值或暴露给前端）
# Supabase 连接池器（应用运行时，6543）。注意：URL 中不要带 sslmode 参数，
# SSL 由代码层配置（src/db/client.ts 与 scripts/migrate.ts 中 ssl: { rejectUnauthorized: false }）；
# pg 8.x 会把 URL 的 sslmode=require 解析为证书链校验，导致自签证书连接失败。
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:6543/postgres

# JWT 配置
JWT_SECRET=change-me-to-a-strong-random-secret
# access token 有效期（默认 1h），如 15m / 2h / 7d；
# 无状态、不做黑名单，登出后残留窗口 ≤ 该值，续期由 refresh 承担
JWT_EXPIRES_IN=1h
# refresh token 专用密钥（缺省回退 JWT_SECRET，建议独立配置）
# 留空与纯空白一律视为「未设置」，等同回退 JWT_SECRET（不会把空串当密钥签发）
JWT_REFRESH_SECRET=
# 勾选「记住我」时的 refresh token 有效期（默认 30d）
REFRESH_EXPIRES_IN=30d
# 未勾选「记住我」（短会话）时的 refresh token 有效期（默认 1d）
REFRESH_EXPIRES_IN_SHORT=1d

# 种子管理员密码：**仅对全新库的首次 seed 生效**。
# 已有 admin 的库上重跑 seed 时，insert 走 onConflictDoNothing 被跳过（seed.ts:109-121），
# 不会覆盖现有密码——所以线上改密后重跑 seed 是安全的，此处留默认值也不影响已上线账号。
# 但新建库（含演示库重置）必须显式设置强口令，勿沿用 admin123。
SEED_ADMIN_PASSWORD=admin123

# API 日志开关（默认 true；设为 false 关闭 api 类型日志）
LOG_API_ENABLED=true

# 日志定时清理（默认每日北京时间 03:00，全部类型统一保留 30 天）
# 设为 false 关闭定时清理
LOG_CLEANUP_ENABLED=true
# 执行计划 cron 表达式（服务器为 UTC，表达式的时区固定为 Asia/Shanghai）
LOG_CLEANUP_CRON=0 3 * * *
# 日志保留天数（正整数，非法值回退 30）
LOG_RETENTION_DAYS=30

# refresh_tokens 过期行定时清理（默认每日北京时间 03:30，日志清理之后错峰；设为 false 关闭）
REFRESH_TOKEN_CLEANUP_ENABLED=true
REFRESH_TOKEN_CLEANUP_CRON=30 3 * * *

# 演示模式（Phase 0，契约 v1.10.0）：true 时启用全局只读守卫（拦截所有非白名单的非 GET
# 请求，返回 403 DEMO_READONLY）并开放 POST /auth/demo-login 快捷登录；默认 false，
# 本地开发保持关闭（关闭时 demo-login 返回 404，行为与常规部署一致）
DEMO_MODE=false
# API 日志 GET 降噪：true 时 GET 请求不记 api 日志（演示环境建议开启，非 GET 照记）；默认 false 全记
LOG_API_SKIP_GET=false

# 应用端口（nest start 监听）
PORT=3000

# Supabase Storage（我的账户头像上传，仅服务端中转使用，严禁提交真实值或暴露给前端）
# 注意使用新 API key 体系（Settings > API Keys）：Secret key 为 sb_secret_ 前缀，
# 不是 JWT，调用 Storage / Data API 时走 apikey 请求头（supabase-js 已封装）；
# 旧 service_role JWT key 将于 2026 年底废弃，不再使用。
# bucket avatars（public read）由 pnpm storage:init 幂等创建。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# CORS 允许的前端来源（逗号分隔）。不设置时用 main.ts 内置白名单：
# localhost:5173/5174/4173/3000/3001 + https://react.baiwumm.com + https://vue.baiwumm.com。
# 只需列 React / Vue 两端域名——Next / Nuxt 是独立全栈、不调用本服务（AGENTS §4）。
# 线上部署时按实际域名显式配置。
CORS_ORIGINS=https://react.baiwumm.com,https://vue.baiwumm.com

