# Better Admin — Nuxt 端环境变量参考（复制为 .env 后填真实值；真实密钥严禁提交）
# 文件名必须是 .env：Nuxt CLI 经 c12 加载 dotenv 时默认只读 .env（.env.local 需显式 --dotenv，
# 项目 dev/build 脚本未带），scripts/clean-logs.mjs 也按 .env 读取。
# 服务端密钥由 server/ 代码直接读取 process.env（与 Next / Nest 端命名一致）；
# 前端可见变量必须带 NUXT_PUBLIC_ 前缀（经 runtimeConfig.public 注入）。

# ===== 服务端：数据库（Supabase PostgreSQL，仅服务端可见）=====
# 端口二选一：5432 = session pooler（本地 dev 推荐：事务池模式下闲置客户端连接会被
# 池端回收，复用半开连接导致查询随机挂起——实测 6543 每轮并发后约 4/10 连接 wedged，
# 5432 稳定，与 next/.env.example 同口径）；6543 = transaction pooler（部署到
# Render / Vercel 等平台时用，并发连接数受限的场景更需要它，prepare 已在代码层禁用）。
# 无论哪个端口，URL 中禁止携带 sslmode 参数（SSL 由代码层配置）
DATABASE_URL=

# ===== 服务端：JWT 双令牌（jose HS256）=====
# access 令牌签名密钥（必填）
JWT_SECRET=
# refresh 令牌独立签名密钥（留空回退 JWT_SECRET，生产环境应独立设置）
JWT_REFRESH_SECRET=
# access 有效期（默认 1h）
JWT_EXPIRES_IN=1h
# refresh 有效期：记住我 30d / 未记住 1d
REFRESH_EXPIRES_IN=30d
REFRESH_EXPIRES_IN_SHORT=1d

# ===== 服务端：Supabase Storage（头像上传中转，M3 启用；仅服务端持有密钥）=====
SUPABASE_URL=
# 使用 sb_secret_ 前缀的 API 密钥，只走 apikey 请求头
SUPABASE_SECRET_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# ===== 服务端：演示模式（契约 v1.10.0，与 Nest / Next 端同名变量语义一致）=====
# true 时开启演示只读：非白名单写请求一律 403 DEMO_READONLY，并开放
# POST /api/auth/demo-login 快捷登录（缺省 false，本地开发无感）
DEMO_MODE=false

# ===== 前端公开变量（浏览器可见）=====
NUXT_PUBLIC_APP_NAME=Better Admin
NUXT_PUBLIC_APP_DESC=一个探索多技术栈全栈开发的 Admin 项目。
# 同源 API（Nitro server routes），无需修改
NUXT_PUBLIC_API_BASE_URL=/api
