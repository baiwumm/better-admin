# 服务端数据库连接（仅服务端，严禁提交真实值或暴露给前端）
# Supabase 连接池器（应用运行时，6543）。注意：URL 中不要带 sslmode 参数，
# SSL 由代码层配置（src/db/client.ts 与 scripts/migrate.ts 中 ssl: { rejectUnauthorized: false }）；
# pg 8.x 会把 URL 的 sslmode=require 解析为证书链校验，导致自签证书连接失败。
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:6543/postgres

# JWT 配置
JWT_SECRET=change-me-to-a-strong-random-secret
# access token 有效期（默认 7d），如 15m / 2h / 7d
JWT_EXPIRES_IN=7d
# refresh token 专用密钥（缺省回退 JWT_SECRET，建议独立配置）
JWT_REFRESH_SECRET=
# refresh token 有效期（默认 30d）
REFRESH_EXPIRES_IN=30d

# 种子管理员密码（缺省 admin123）
SEED_ADMIN_PASSWORD=admin123

# API 日志开关（默认 true；设为 false 关闭 api 类型日志）
LOG_API_ENABLED=true

# 应用端口（nest start 监听）
PORT=3000
